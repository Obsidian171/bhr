VITE_SITE_URL=https://bhr.p7z.ru

# Скрытый вход в панель. Используется в двух местах:
#   /apply  — «Имя / проект» (логин, домен подставляется автоматически)
#              и «О музыке и себе» (пароль);
#   /booth  — одно поле «Код» (только пароль).
# Код = пароль сотрудника в Supabase, поэтому при его смене в Supabase
# меняй и VITE_BOOTH_KEY.
