-- REVERB RECORDS — frontend env
-- Copy to `.env` (or `.env.local`) and fill real values from
-- Supabase → Project Settings → API Keys.
-- Without them the app shows a "database not configured" screen and loads no data.
-- Run `supabase/schema.sql` in the SQL Editor before the first request.
--
-- The publishable key is meant for the browser: access is limited by RLS,
-- not by hiding the key. The secret key never belongs in a VITE_ variable.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Legacy name, still supported if your key is named that way:
# VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: canonical site URL used for meta tags / auth redirects
VITE_SITE_URL=http://localhost:5173

# Hidden admin panel at /booth. The staff account email and the access code live
# here. On /apply the first field is the login (the domain is appended
# automatically) and the second one is the password; on /booth it is a single
# "пароль" field. The code must match that account's password in Supabase.
VITE_BOOTH_EMAIL=you@example.com
VITE_BOOTH_KEY=your-access-code

# Image uploads via ImgBB (converts to WebP)
VITE_IMGBB_API_KEY=your-imgbb-api-key

# Optional: link to the «Зал славы» playlist (Spotify / YouTube / Bandcamp).
# If empty, the button on /hall is not rendered.
VITE_HALL_PLAYLIST_URL=

# Direct stream address for RADIO REVERB. Icecast / Shoutcast mounts (http://host:port/stream)
# or HLS (.m3u8, native in Safari, needs hls.js for Chrome) work through a hidden
# <audio> element. If empty, the «Прямой эфир» controls are hidden and only the
# catalog-based station is available. The host must allow cross-origin playback.
VITE_RADIO_STREAM_URL=